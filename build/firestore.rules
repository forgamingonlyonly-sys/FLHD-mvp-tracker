rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function secret() { return get(/databases/$(db)/documents/config/secret).data; }
    function mePath() { return /databases/$(db)/documents/members/$(request.auth.uid); }
    function sessPath() { return /databases/$(db)/documents/meta/session; }
    function signedIn() { return request.auth != null && exists(mePath()); }
    // "Log out all devices": logins from before the latest reset stop working (except the Admin who pressed it)
    function fresh() {
      let s = get(sessPath()).data;
      let j = get(mePath()).data.get('joinedAt', null);
      return !(s.get('resetAt', null) is timestamp)
        || s.get('by', '') == request.auth.uid
        || (j is timestamp && j > s.resetAt);
    }
    // Admin "Log out" on one person: their login from before kicks/<uid>.at stops working (they can log in again)
    function kickPath() { return /databases/$(db)/documents/kicks/$(request.auth.uid); }
    function notKicked() {
      let j = get(mePath()).data.get('joinedAt', null);
      return !exists(kickPath()) || (j is timestamp && j > get(kickPath()).data.at);
    }
    function member() { return signedIn() && (!exists(sessPath()) || fresh()) && notKicked(); }
    function role() { return get(mePath()).data.get('role', 'editor'); }
    function admin() { return member() && role() == 'admin'; }
    function editor() { return member() && role() in ['editor', 'admin']; }
    function timer() { return member() && role() in ['editor', 'admin', 'timer']; }
    match /members/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.joinedAt == request.time && (
        (request.resource.data.role == 'admin' && (request.resource.data.pass == secret().adminpass
          || (secret().get('adminpass2', '') != '' && request.resource.data.pass == secret().get('adminpass2', ''))
          || (secret().get('adminpass3', '') != '' && request.resource.data.pass == secret().get('adminpass3', '')))) ||
        (request.resource.data.role == 'editor' && request.resource.data.pass == secret().pass) ||
        (request.resource.data.role == 'timer' && request.resource.data.pass == secret().timerpass) ||
        (request.resource.data.role == 'viewer' && request.resource.data.pass == secret().viewpass));
    }
    match /config/{d} { allow read, write: if false; }
    match /names/{uid} {
      allow read: if member();
      allow write: if member() && request.auth.uid == uid;
    }
    match /mvps/{id} { allow write: if timer(); }
    match /cycle/{id} { allow write: if timer(); }
    match /loot/{id} { allow delete: if admin(); }
    // log out one person: only the Admin sets it; each device reads only its own
    match /kicks/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if admin() && uid != request.auth.uid && request.resource.data.at == request.time;
    }
    match /meta/{id} {
      allow create, update: if id == 'session' && admin() && request.resource.data.resetAt == request.time;
      // "Refresh all trackers": only the Admin presses it
      allow create, update: if id == 'refresh' && admin() && request.resource.data.at == request.time;
    }
    // who is online (nicknames): only the Admin can read it
    match /presence_who/{t} {
      allow read: if admin();
      allow create, update: if member() && request.resource.data.uid == request.auth.uid;
      allow delete: if member();
    }
    // Auto-detect: anyone signed in can count the watchers; only the Admin can see who
    match /watchers/{t} {
      allow write: if timer() && (request.resource == null || request.resource.data.keys().hasOnly(['at']));
    }
    match /watchers_who/{t} {
      allow read: if admin();
      allow create, update: if timer() && request.resource.data.uid == request.auth.uid;
      allow delete: if timer();
    }
    // Discord board: FLHD / Timers / Admin read the webhook settings; only the Admin sets them.
    // discordlog = records of the old individual posts (removed): only the Admin's clean-up reads and deletes them
    match /config_discord/{d} {
      allow read: if timer();
      allow write: if admin();
    }
    match /discordlog/{k} {
      allow read, delete: if admin();
    }
    match /discordboard/{d} {
      allow read, write: if timer();
    }
    // Auto-detect review log: watchers add entries; only the Admin reads them and marks them undone
    match /autolog/{k} {
      allow create: if timer();
      allow read, update, delete: if admin();
    }
    // per-MVP log history: anyone who can log kills adds entries; only the Admin reads them
    match /mvplog/{mvp}/entries/{e} {
      allow create: if timer() && request.resource.data.by == request.auth.uid;
      allow read, delete: if admin();
    }
    // error reports from guildmates' trackers: anyone signed in adds their own (small); only the Admin reads and deletes
    match /errlog/{e} {
      allow create: if member() && request.resource.data.uid == request.auth.uid
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 300
        && request.resource.data.get('stack', '').size() <= 700;
      allow read, delete: if admin();
    }
    // MVP pictures: everyone signed in sees them; only the Admin adds, changes or removes them
    match /portraits/{id} {
      allow read: if member();
      allow write: if admin();
    }
    // Auto-detect: watchers claim each kill so exactly one of them logs it
    match /killclaim/{k} {
      allow read, write: if timer();
    }
    match /{col}/{id} {
      allow read: if member() && !(col in ['members', 'config', 'names', 'presence_who', 'watchers_who', 'config_discord', 'discordlog', 'discordboard', 'autolog', 'portraits', 'killclaim', 'kicks', 'errlog']);
      allow create, update: if editor() && !(col in ['members', 'config', 'names', 'watchers_who', 'config_discord', 'discordlog', 'discordboard', 'autolog', 'portraits', 'killclaim', 'kicks', 'errlog']) && !(col == 'meta' && id in ['session', 'refresh']);
      allow delete: if editor() && !(col in ['members', 'config', 'names', 'loot', 'config_discord', 'discordlog', 'discordboard', 'autolog', 'portraits', 'killclaim', 'kicks', 'errlog']) && !(col == 'meta' && id in ['session', 'refresh']);
      allow write: if col in ['presence_admin', 'presence_editor', 'presence_timer', 'presence_viewer'] && member()
        && (request.resource == null || request.resource.data.keys().hasOnly(['at']));
    }
  }
}
