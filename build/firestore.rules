rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function secret() { return get(/databases/$(db)/documents/config/secret).data; }
    function mePath() { return /databases/$(db)/documents/members/$(request.auth.uid); }
    function sessPath() { return /databases/$(db)/documents/meta/session; }
    function signedIn() { return request.auth != null && exists(mePath()); }
    // "Log out all devices": logins from before the latest reset stop working (except the Admin who pressed it)
    function fresh() {
      let s = get(sessPath()).data;
      let j = get(mePath()).data.get('joinedAt', null);
      return !(s.get('resetAt', null) is timestamp)
        || s.get('by', '') == request.auth.uid
        || (j is timestamp && j > s.resetAt);
    }
    function member() { return signedIn() && (!exists(sessPath()) || fresh()); }
    function role() { return get(mePath()).data.get('role', 'editor'); }
    function admin() { return member() && role() == 'admin'; }
    function editor() { return member() && role() in ['editor', 'admin']; }
    function timer() { return member() && role() in ['editor', 'admin', 'timer']; }
    match /members/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.joinedAt == request.time && (
        (request.resource.data.role == 'admin' && (request.resource.data.pass == secret().adminpass
          || (secret().get('adminpass2', '') != '' && request.resource.data.pass == secret().get('adminpass2', '')))) ||
        (request.resource.data.role == 'editor' && request.resource.data.pass == secret().pass) ||
        (request.resource.data.role == 'timer' && request.resource.data.pass == secret().timerpass) ||
        (request.resource.data.role == 'viewer' && request.resource.data.pass == secret().viewpass));
    }
    match /config/{d} { allow read, write: if false; }
    match /names/{uid} {
      allow read: if member();
      allow write: if member() && request.auth.uid == uid;
    }
    match /mvps/{id} { allow write: if timer(); }
    match /cycle/{id} { allow write: if timer(); }
    match /bossevent/{id} { allow write: if timer(); }
    match /loot/{id} { allow delete: if admin(); }
    match /meta/{id} {
      allow create, update: if id == 'session' && admin() && request.resource.data.resetAt == request.time;
    }
    // who is online (nicknames): only the Admin can read it
    match /presence_who/{t} {
      allow read: if admin();
      allow create, update: if member() && request.resource.data.uid == request.auth.uid;
      allow delete: if member();
    }
    // Auto-detect: anyone signed in can count the watchers; only the Admin can see who
    match /watchers/{t} {
      allow write: if timer() && (request.resource == null || request.resource.data.keys().hasOnly(['at']));
    }
    match /watchers_who/{t} {
      allow read: if admin();
      allow create, update: if timer() && request.resource.data.uid == request.auth.uid;
      allow delete: if timer();
    }
    // Discord posts: FLHD / Timers / Admin read the webhook and claim each message once; only the Admin sets it
    match /config_discord/{d} {
      allow read: if timer();
      allow write: if admin();
    }
    match /discordlog/{k} {
      allow read, create: if timer();
    }
    match /discordboard/{d} {
      allow read, write: if timer();
    }
    match /{col}/{id} {
      allow read: if member() && !(col in ['members', 'config', 'names', 'presence_who', 'watchers_who', 'config_discord', 'discordlog', 'discordboard']);
      allow create, update: if editor() && !(col in ['members', 'config', 'names', 'watchers_who', 'config_discord', 'discordlog', 'discordboard']) && !(col == 'meta' && id == 'session');
      allow delete: if editor() && !(col in ['members', 'config', 'names', 'loot', 'config_discord', 'discordlog', 'discordboard']);
      allow write: if col in ['presence_admin', 'presence_editor', 'presence_timer', 'presence_viewer'] && member()
        && (request.resource == null || request.resource.data.keys().hasOnly(['at']));
    }
  }
}
